{
  "info": {
    "name": "CivicLedger — Transparent Local Governance & Budgeting API",
    "_postman_id": "civicledger-governance-api-v1",
    "description": "Postman collection for testing Authentication, Budgets, Departments, Expenditures, Proposals, Voting, Projects, Feedback, and CSV Reports.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "citizenToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "budgetId", "value": "" },
    { "key": "departmentId", "value": "" },
    { "key": "proposalId", "value": "" },
    { "key": "projectId", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Auth - Register Citizen",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Citizen\",\n  \"email\": \"postman.citizen@example.org\",\n  \"password\": \"Password123!\",\n  \"ward\": \"Ward 1 - Central\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Auth - Login Demo Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@civicledger.demo\",\n  \"password\": \"AdminPassword123!\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Public Budget Dashboard",
      "request": { "method": "GET", "url": "{{baseUrl}}/budgets/dashboard" }
    },
    {
      "name": "Proposals - Submit (Citizen)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{citizenToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Ward 3 Community Solar Water Fountain\",\n  \"description\": \"Install a filtered solar-chilled public drinking water station near the community park entrance.\",\n  \"category\": \"Drinking water\",\n  \"location\": \"Ward 3 - Central Park Gate\",\n  \"estimatedBudget\": 25000\n}"
        },
        "url": "{{baseUrl}}/proposals"
      }
    },
    {
      "name": "Proposals - Approve (Admin)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Approved\",\n  \"adminRemarks\": \"Cleared technical review for participatory voting.\"\n}"
        },
        "url": "{{baseUrl}}/proposals/{{proposalId}}/status"
      }
    },
    {
      "name": "Voting - Cast Vote (Citizen)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{citizenToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/votes/{{proposalId}}"
      }
    },
    {
      "name": "Spending - Record Expenditure (Admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"budgetId\": \"{{budgetId}}\",\n  \"departmentId\": \"{{departmentId}}\",\n  \"title\": \"LED Streetlight Fixture Batch\",\n  \"description\": \"Procurement of 25 solar LED fixtures for Oakridge Corridor.\",\n  \"amount\": 42000,\n  \"vendorName\": \"CivicLight Energy Ltd.\"\n}"
        },
        "url": "{{baseUrl}}/expenditures"
      }
    },
    {
      "name": "Reports - Export CSV",
      "request": { "method": "GET", "url": "{{baseUrl}}/reports/export?type=budget" }
    }
  ]
}
